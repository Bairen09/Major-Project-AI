# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/localboost

# JWT
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Password Reset
RESET_TOKEN_EXPIRES_IN=3600000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Cloudinary (Optional - for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI (Optional - for AI text generation & assistant)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Groq (Optional - for faster AI text generation)
GROQ_API_KEY=

# Image Generation (Optional - 'openai', 'gemini', or 'flux')
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
IMAGE_MODEL=dall-e-3
